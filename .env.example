# Copy to `.env` (repo root or server/) and adjust. Real environment variables take precedence.

# --- Server ---
PORT=4000
# REQUIRED in production (NODE_ENV=production refuses to start without it).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Where pharmacore.db and backups/ live. Defaults to server/data.
# PHARMACORE_DATA_DIR=D:\PharmaCoreData

# Password for the `admin` owner account created on first run only (empty database).
# Change it from "My account" after the first login.
INITIAL_ADMIN_PASSWORD=admin123

# --- AI business assistant (optional) ---
# Any OpenAI-compatible Chat Completions endpoint. Leave AI_MODEL empty to disable the assistant.
# OpenAI:     AI_BASE_URL=https://api.openai.com/v1      AI_MODEL=gpt-4o-mini  AI_API_KEY=sk-...
# Ollama:     AI_BASE_URL=http://localhost:11434/v1      AI_MODEL=qwen2.5:7b   (no key needed)
# LM Studio:  AI_BASE_URL=http://localhost:1234/v1       AI_MODEL=<loaded model id>
# The model must support tool/function calling.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=45000
AI_MAX_TOOL_ROUNDS=5
# Per-user requests allowed per window.
AI_RATE_LIMIT=30
AI_RATE_WINDOW_MS=300000
